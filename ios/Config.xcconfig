// Settings for the iOS app. `/$()/` keeps the `//` in URLs (xcconfig treats `//` as a comment).
// Put your own values in Config.local.xcconfig (not committed) to override these.

APP_BUNDLE_ID = com.example.extract
DEVELOPMENT_TEAM =

// The Express API, including /api. The Simulator can reach your Mac as localhost.
API_BASE_URL = http:/$()/localhost:3000/api

// "dev" = offline login against a backend started with AUTH_MODE=dev (npm run local).
// "auth0" = real sign-in; fill in the three AUTH0_* values below.
AUTH_MODE = dev

// Auth0 "Native" application (not the SPA one the website uses), same API audience.
AUTH0_DOMAIN = your-tenant.us.auth0.com
AUTH0_CLIENT_ID =
AUTH0_AUDIENCE = https:/$()/your-api-identifier

#include? "Config.local.xcconfig"
