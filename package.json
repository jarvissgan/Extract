{
   "name": "extract",
   "private": true,
   "version": "0.0.0",
   "type": "module",
   "scripts": {
      "local": "node scripts/local.js",
      "dev": "cross-env NODE_ENV=development concurrently \"vite --clearScreen false\" \"nodemon -r dotenv/config server.js\"",
      "test": "node scripts/local.js --db-only && cross-env AUTH_MODE=dev node -r dotenv/config --test --test-concurrency=1 \"tests/**/*.test.js\"",
      "test:e2e": "playwright test",
      "lint": "eslint .",
      "typecheck": "tsc --noEmit -p .",
      "build": "vite build",
      "preview": "vite preview",
      "db:migrate": "node -r dotenv/config scripts/migrate.js",
      "db:seed": "node -r dotenv/config scripts/seed.js",
      "db:reset": "node -r dotenv/config scripts/db-reset.js",
      "db:down": "docker compose down"
   },
   "dependencies": {
      "@auth0/auth0-react": "^2.3.0",
      "@mantine/charts": "^8.3.8",
      "@mantine/core": "^8.3.8",
      "@mantine/dates": "^8.3.8",
      "@mantine/hooks": "^8.3.8",
      "@mantine/modals": "^8.3.8",
      "@mantine/notifications": "^8.3.8",
      "@tabler/icons-react": "^3.35.0",
      "axios": "^1.7.9",
      "cors": "^2.8.5",
      "dayjs": "^1.11.19",
      "dotenv": "^16.4.7",
      "express": "^4.21.2",
      "express-oauth2-jwt-bearer": "^1.6.1",
      "express-rate-limit": "^8.7.3",
      "helmet": "^8.3.0",
      "mysql2": "^3.24.6",
      "react": "^19.1.0",
      "react-dom": "^19.1.0",
      "react-router": "^7.4.0",
      "recharts": "^3.4.1",
      "sqids": "^0.3.0",
      "zod": "^4.6.7"
   },
   "devDependencies": {
      "@eslint/js": "^9.15.0",
      "@playwright/test": "^1.56.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^4.3.4",
      "concurrently": "^10.0.6",
      "cross-env": "^10.1.0",
      "eslint": "^9.15.0",
      "eslint-plugin-react": "^7.37.2",
      "eslint-plugin-react-hooks": "^5.0.0",
      "eslint-plugin-react-refresh": "^0.4.14",
      "globals": "^15.12.0",
      "nodemon": "^3.1.14",
      "postcss": "^8.5.6",
      "postcss-preset-mantine": "^1.18.0",
      "postcss-simple-vars": "^7.0.1",
      "typescript": "^5.9.3",
      "typescript-eslint": "^8.72.1",
      "vite": "^6.0.1"
   }
}
