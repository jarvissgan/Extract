# deploy/.env: production settings and secrets. Created by setup.sh with random passwords.
# Lives ONLY on the server (chmod 600). Never commit it; keep a copy of the secrets in
# your password manager.

# ---- public settings ----
APP_DOMAIN=extract.example.com
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-spa-client-id
AUTH0_AUDIENCE=https://your-api-identifier
RATE_LIMIT_PER_MINUTE=300
# branch that deploy.sh pulls
DEPLOY_BRANCH=master

# ---- secrets (generated) ----
DB_PASSWORD=
MARIADB_ROOT_PASSWORD=
RESTIC_PASSWORD=

# ---- backups ----
# Local by default. For off-server copies (recommended), e.g. Cloudflare R2 or Backblaze B2:
#   RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
RESTIC_REPOSITORY=/var/backups/extract
