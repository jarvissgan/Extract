# Copy to .env and fill in.

# ---- Frontend (bundled into the browser JS: never put secrets here) ----
VITE_authDomain=your-tenant.us.auth0.com
VITE_authClientID=your-spa-client-id
VITE_redirectURL=http://localhost:5173
VITE_authApiAudience=https://your-api-identifier
VITE_axiosBaseUrl=http://localhost:3000/api

# ---- Backend only (read by server.js; never exposed to the browser) ----
PORT=3000
# browser origins allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:5173
# requests per minute per IP to /api
RATE_LIMIT_PER_MINUTE=300
AUTH0_AUDIENCE=https://your-api-identifier
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com/
AUTH0_TOKEN_SIGNING_ALG=RS256

# Your real database, used by `npm run dev` and `npm run db:migrate`.
# The dev tools (`npm run local`, `npm test`, db:seed, db:reset) never use these:
# they always use their own Docker database on localhost:3307.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=extract

# Port for the local Docker database (change it if 3307 is taken)
# LOCAL_DB_PORT=3307

# ---- Offline development ----
# Don't set these here; `npm run local` and `npm test` set them for you.
# AUTH_MODE=dev        backend accepts `Bearer dev:<email>` instead of Auth0 tokens
# VITE_AUTH_MODE=dev   frontend shows a dev login page instead of redirecting to Auth0
